// Prisma schema for the admin app and, from phase 3, the sync worker.
//
// The database is not a copy of the Shopify catalog: Shopify stays the source of
// truth for products, inventory and orders (ADR-0007). What lives here is state
// Shopify has nowhere to put — OAuth sessions, and the bundles this app defines.
//
// Schema changes land as migration files under prisma/migrations. `prisma db
// push` is never used: it applies a diff with no artefact in the repository, so
// the schema a store runs cannot be reconstructed from history (rule 11).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// OAuth sessions, written and read by PrismaSessionStorage from
/// @shopify/shopify-app-session-storage-prisma. The column set is dictated by
/// that adapter — it maps a Session object field by field — so fields are not
/// removed here even when this app never reads them. The adapter looks the table
/// up by the model name `Session`; renaming it raises MissingSessionTableError.
///
/// Both offline and online sessions live in this table, told apart by isOnline.
/// Offline sessions carry the token background work uses (webhooks, the worker):
/// they outlive any staff member's admin session. Online sessions carry a token
/// scoped to the staff member who is looking at the app right now, with their
/// permissions and their session's lifetime, and are what user-facing requests
/// act under.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?
  locale              String?
  collaborator        Boolean?
  emailVerified       Boolean?
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// A routine set: one product per step, assembled by the merchant in the app and
/// rendered by the bundle-builder section on the storefront (ADR-0012).
model Bundle {
  id        String       @id @default(cuid())
  /// myshopify.com domain. Every row is scoped to a shop because one deployment
  /// serves many stores, and a missing shop filter is a cross-tenant data leak
  /// rather than a bug in one screen.
  shop      String
  title     String
  handle    String
  status    BundleStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  items     BundleItem[]

  @@unique([shop, handle])
  @@index([shop, status])
}

/// One product's place in a bundle. Products are referenced by Admin API GID and
/// never copied: a title cached here would go stale the moment a merchant edits
/// the product in the admin.
model BundleItem {
  id          String      @id @default(cuid())
  bundleId    String
  bundle      Bundle      @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productGid  String
  routineStep RoutineStep
  position    Int

  /// A routine set holds at most one product per step. Enforced here rather than
  /// in application code: a check-then-insert in the app is a race, the unique
  /// index is not (rule 10).
  @@unique([bundleId, routineStep])
  @@index([bundleId])
}

/// Mirrors the `custom.routine_step` metafield, whose choice list is exactly
/// cleanse / treat / moisturize (ADR-0003).
enum RoutineStep {
  CLEANSE
  TREAT
  MOISTURIZE
}

enum BundleStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// One accepted webhook delivery, keyed by the id Shopify puts on it.
///
/// This table exists to answer one question — "have I already accepted this
/// exact delivery?" — and it answers it with a primary key rather than with a
/// lookup in application code. Shopify retries a delivery it did not get a
/// timely 200 for, and it makes no at-most-once promise even when it did, so
/// duplicates are normal traffic rather than an error case.
///
/// Rule 10: the insert is `ON CONFLICT DO NOTHING` and the duplicate is
/// detected from the row count. A `SELECT` before the `INSERT` would be a race
/// between two deliveries of the same webhook arriving on two connections at
/// once — both would see nothing and both would enqueue.
model WebhookDelivery {
  /// X-Shopify-Webhook-Id: unique per delivery attempt of one event.
  id         String   @id
  /// X-Shopify-Event-Id: shared by every delivery produced by one merchant
  /// action. Stored but not the key — deduplicating on it would drop a genuine
  /// second delivery to a different topic from the same action.
  eventId    String?
  shop       String
  topic      String
  /// The version the payload was serialised with, which is the subscription's
  /// version and not necessarily the one this code calls (ADR-0009). Recorded
  /// so a payload that stops parsing can be traced to a version drift.
  apiVersion String
  receivedAt DateTime @default(now())

  @@index([shop, receivedAt])
}

/// The queue (ADR-0007, decision 3).
///
/// A table rather than Redis: the webhook row above and the job below are
/// written in one transaction, so "accepted and enqueued" cannot come apart.
/// With a broker that is a distributed-commit problem for a queue that carries
/// a handful of jobs per minute.
model Job {
  id            String    @id @default(cuid())
  shop          String
  kind          String
  /// The webhook payload, or whatever the enqueuer needs. `jsonb`, so a job can
  /// be inspected in the sync log without a second table per kind.
  payload       Json
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  /// After this many failed attempts the job stops being retried and becomes
  /// DEAD — the dead-letter state. Per-row rather than global so one topic can
  /// be given a different budget without a migration.
  maxAttempts   Int       @default(5)
  /// The earliest time a worker may claim this job. Exponential backoff is
  /// expressed by pushing this into the future, which keeps the retry schedule
  /// in the same query that finds work rather than in a timer somewhere.
  runAt         DateTime  @default(now())
  /// Set while a worker holds the job. A worker that dies leaves the row RUNNING
  /// with a stale lockedAt; the reaper uses this to release it.
  lockedAt      DateTime?
  lockedBy      String?
  lastError     String?
  /// What the job produced, for the kinds that produce something a person reads
  /// — today the catalog export's summary of the store. `jsonb`, and null for
  /// every handler whose only output is a change somewhere else.
  ///
  /// Separate from `payload` on purpose: that column is the job's input, and a
  /// retry re-reads it. Writing a result into it would mean a handler editing
  /// its own instructions, and the two would be impossible to tell apart when
  /// reading a row six months from now.
  result        Json?
  /// Carried from the webhook request through every log line this job produces
  /// and into the Admin API calls it makes, so one delivery can be followed end
  /// to end in the logs.
  correlationId String
  /// Which delivery produced this job, when one did. Null for jobs enqueued from
  /// the UI.
  webhookId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  finishedAt    DateTime?

  /// The claim query orders by runAt over PENDING rows; without this index that
  /// is a sequential scan taken under a row lock on every poll.
  @@index([status, runAt])
  /// The sync log: one shop's jobs, newest first.
  @@index([shop, createdAt])
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  /// Failed, attempts left, waiting for runAt.
  FAILED
  /// Out of attempts. The dead-letter state: nothing retries it automatically,
  /// and it is what the sync log surfaces for manual retry.
  DEAD
}
