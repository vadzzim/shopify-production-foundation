# Copy to .env and fill in. .env is never committed.
# Every variable is validated with zod at startup, so a missing required value
# crashes the process immediately instead of failing at first use.

# --- Shopify app ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel.example.com
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders
SHOPIFY_STORE=your-store.myshopify.com

# The Admin API version is deliberately NOT here. It is a code-level
# compatibility contract tied to the queries in this repository, so it lives in
# packages/shared/src/api-version.ts and is not overridable per environment.

# --- Database ---
# Local PostgreSQL. If you don't have one: docker compose up -d
# Rationale for the database and ORM choice: docs/adr/0007-database-and-orm.md
DATABASE_URL=postgresql://nordlys:nordlys@localhost:5432/nordlys?schema=public

# --- Mock ERP (roadmap v2) ---
ERP_BASE_URL=http://localhost:4000
ERP_WEBHOOK_SECRET=

# --- Misc ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
