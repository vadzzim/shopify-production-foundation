{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Polaris web components are custom elements registered by the Polaris
    // script from Shopify's CDN. @shopify/polaris-types declares them as JSX
    // intrinsic elements; @shopify/app-bridge-types declares the global
    // `shopify` object. Neither is imported at runtime, so both are listed here.
    "types": ["@shopify/polaris-types", "@shopify/app-bridge-types"]
  },
  "include": ["src/web/**/*.ts", "src/web/**/*.tsx"]
}
